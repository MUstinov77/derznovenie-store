# Скопируйте в .env и заполните. Файл .env в git не попадает.
DEBUG=False
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
TELEGRAM_URL=https://t.me/ваш_канал
# Адрес админки (со слэшем на конце), лучше сменить на непредсказуемый
ADMIN_URL=admin/
# Включайте HSTS надолго только когда HTTPS точно работает (31536000 = год)
SECURE_HSTS_SECONDS=3600
SECURE_SSL_REDIRECT=True

# MySQL вместо SQLite (если задан DB_NAME). Нужен: pip install -r requirements-mysql.txt
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
