[Unit]
Description=Derznovenie (gunicorn)
After=network.target

[Service]
User=www-data
WorkingDirectory=/srv/derznovenie
EnvironmentFile=/srv/derznovenie/.env
ExecStart=/srv/derznovenie/.venv/bin/gunicorn config.wsgi:application --bind unix:/run/derznovenie.sock --workers 3
Restart=always

[Install]
WantedBy=multi-user.target
