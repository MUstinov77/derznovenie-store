name: Deploy

on:
  push:
    branches: [main]
  pull_request_review:
    types: [submitted]

# одновременно идёт только один деплой, новые ждут своей очереди
concurrency:
  group: deploy
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  check:
    # push в main или одобренный (approved) pull request в main
    if: >
      github.event_name == 'push' ||
      (github.event.review.state == 'approved' &&
       github.event.pull_request.base.ref == 'main' &&
       github.event.pull_request.head.repo.full_name == github.repository)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # для PR берём коммит из ветки PR, для push — коммит push
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.14'
          cache: pip
      - run: pip install -r requirements.txt
      - name: Django checks and tests
        env:
          DEBUG: 'True'
        run: |
          python manage.py check
          python manage.py makemigrations --check --dry-run
          python manage.py test

  deploy:
    needs: check
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: write
    env:
      SSH_PORT: ${{ secrets.SSH_PORT || '22' }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - name: Image name
        run: |
          echo "IMAGE=ghcr.io/${GITHUB_REPOSITORY,,}" >> "$GITHUB_ENV"
          echo "TAG=${{ github.event.pull_request.head.sha || github.sha }}" >> "$GITHUB_ENV"

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ${{ env.IMAGE }}:${{ env.TAG }}
            ${{ env.IMAGE }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Prepare SSH
        env:
          SSH_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: ${{ secrets.SSH_KNOWN_HOSTS }}
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "$SSH_KEY" > ~/.ssh/id_deploy
          chmod 600 ~/.ssh/id_deploy
          printf '%s\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts

      - name: Upload compose file
        env:
          TARGET: ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }}
          DEPLOY_PATH: ${{ secrets.DEPLOY_PATH }}
        run: |
          scp -i ~/.ssh/id_deploy -P "$SSH_PORT" docker-compose.prod.yml \
            "$TARGET:$DEPLOY_PATH/docker-compose.yml"

      - name: Pull image and restart container
        env:
          TARGET: ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }}
          DEPLOY_PATH: ${{ secrets.DEPLOY_PATH }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GH_ACTOR: ${{ github.actor }}
        run: |
          # токен уходит на сервер через stdin, в логи и аргументы не попадает
          printf '%s' "$GH_TOKEN" | ssh -i ~/.ssh/id_deploy -p "$SSH_PORT" "$TARGET" \
            "docker login ghcr.io -u '$GH_ACTOR' --password-stdin"
          ssh -i ~/.ssh/id_deploy -p "$SSH_PORT" "$TARGET" \
            "DEPLOY_PATH='$DEPLOY_PATH' IMAGE='$IMAGE:$TAG' bash -s" <<'REMOTE'
          set -euo pipefail
          cd "$DEPLOY_PATH"
          mkdir -p data
          export IMAGE
          docker compose pull
          docker compose up -d --remove-orphans
          sleep 10
          if [ -z "$(docker compose ps --status running -q web)" ]; then
            docker compose logs --tail 50 web
            echo "Контейнер не запустился" >&2
            exit 1
          fi
          docker image prune -f
          REMOTE

      - name: Docker logout on server
        if: always()
        env:
          TARGET: ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }}
        run: ssh -i ~/.ssh/id_deploy -p "$SSH_PORT" "$TARGET" "docker logout ghcr.io" || true
